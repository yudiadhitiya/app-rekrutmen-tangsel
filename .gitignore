frontend/dist/
backend/rekr-server
backend/bin/

# Runtime data: contains session secrets, user password hashes and stored records
data/
backend/data/
*.secret

# Password of the first administrator, written when it is made randomly.
initial_admin_password.txt

# Akun uji E2E: dibuat ulang oleh `go run ./cmd/e2eseed`, tidak perlu di repo.
e2e-data/users.json

# Environment
.env
.env.local
*.env

# Google service-account credentials: the private key grants full read/write
# access to every spreadsheet shared with the account. Keep it out of the repo.
backend/secrets/
backend/.secrets/
*.service-account.json
google-key*.json
gcp-*.json
credentials.json
service-account*.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log

# Playwright
test-results/
playwright-report/
blob-report/
