# Contoh konfigurasi backend. Salin ke .env lalu isi sesuai lingkungan.
# Backend tidak memuat .env secara otomatis: ekspor variabelnya lewat shell
# atau lewat systemd EnvironmentFile.

# Server
ADDR=127.0.0.1:8080
DATA_DIR=./data
FRONTEND_DIR=frontend/dist
APP_ROOT=.

# Kunci penandatangan cookie sesi. Wajib di produksi: hex acak minimal 64 karakter.
# Bila dikosongkan, server membuat dan menyimpan sendiri di DATA_DIR/session.secret.
SESSION_SECRET=

# Supabase (opsional)
SUPABASE_URL=
SUPABASE_API_KEY=

# Google Sheets (opsional)
# GOOGLE_SHEET_ID boleh berupa id spreadsheet atau URL lengkap spreadsheet.
GOOGLE_SHEET_ID=
# Path file JSON service account. File harus berizin 0600 (owner saja).
GOOGLE_KEY_FILE=

# Layout tab di spreadsheet.
#   app  = aplikasi memakai tab miliknya sendiri (Rekrutmen, Aktivitas)
#   form = spreadsheet berisi respons Google Form; tab sumber dibaca, tab
#          aplikasi tetap ditulis di tab terpisah
GOOGLE_SHEETS_MODE=app
GOOGLE_SHEETS_TAB_REKRUTMEN=Rekrutmen
GOOGLE_SHEETS_TAB_AKTIVITAS=Aktivitas
GOOGLE_SHEETS_TAB_SUMBER=Form Responses 1
GOOGLE_SHEETS_TAB_PENGGUNA=USERS

# Cara memakai akun app lama.
#   upgrade = cek tab USERS saat login pertama, lalu simpan lokal (default)
#             password lokal memakai hash PBKDF2 ber-salt, jadi password tidak
#             pernah diperiksa dengan hash SHA-256 tanpa salt milik app lama
#   sheet   = selalu cek tab USERS (password selalu dibandingkan dengan hash
#             SHA-256 tanpa salt — kurang aman, hanya untukKEAHLIAN sementara)
#   off     = hanya akun lokal
LEGACY_AUTH_MODE=upgrade

# Keamanan (P-26 s.d. P-28)
# Flag Secure pada cookie sesi:
#   auto  = mengikuti permintaan (TLS langsung atau X-Forwarded-Proto: https) (default)
#   true  = paksa flag Secure; gunakan bila server selalu di belakang TLS
#   false = tanpa paksa; hanya untuk pengembangan lokal
COOKIE_SECURE=auto

# Origin yang boleh memanggil API dari browser, dipisah koma.
# Kosong berarti hanya asal yang sama, yaitu keadaan normal di produksi.
# Contoh: https://rekrutmen.tangsel.go.id
ALLOWED_ORIGINS=

# Batas percobaan login yang gagal per akun dalam 15 menit. Default 10.
LOGIN_MAX_ATTEMPTS=10

# Percaya kepada reverse proxy sendiri yang menulis alamat asli pengirim di
# header X-Forwarded-For. WAJIB true bila aplikasi di belakang nginx, karena
# header itu bisa dipalsukan pemanggil bila tidak dipercaya.
#   true  = pakai entri terakhir X-Forwarded-For (proxy harus menimpa header)
#   false = pakai alamat koneksi (aman, tapi semua pemanggil berbagi satu batas)
TRUST_PROXY=true

# Batas upload massal per akun dalam 10 menit. Default 5.
UPLOAD_MAX_ATTEMPTS=5
