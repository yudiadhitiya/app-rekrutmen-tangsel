# Contoh konfigurasi backend. Salin ke .env lalu isi sesuai lingkungan.
# Backend tidak memuat .env secara otomatis: ekspor variabelnya lewat shell
# atau lewat systemd EnvironmentFile.

# Server
ADDR=127.0.0.1:8080
DATA_DIR=./data
FRONTEND_DIR=frontend/dist
APP_ROOT=.

# Kunci penandatangan cookie sesi. Wajib di produksi: hex acak minimal 64 karakter.
# Bila dikosongkan, server membuat dan menyimpan sendiri di DATA_DIR/session.secret.
SESSION_SECRET=

# Supabase (opsional)
SUPABASE_URL=
SUPABASE_API_KEY=

# Google Sheets (opsional)
# GOOGLE_SHEET_ID boleh berupa id spreadsheet atau URL lengkap spreadsheet.
GOOGLE_SHEET_ID=
# Path file JSON service account. File harus berizin 0600 (owner saja).
GOOGLE_KEY_FILE=

# Layout tab di spreadsheet.
#   app  = aplikasi memakai tab miliknya sendiri (Rekrutmen, Aktivitas)
#   form = spreadsheet berisi respons Google Form; tab sumber dibaca, tab
#          aplikasi tetap ditulis di tab terpisah
GOOGLE_SHEETS_MODE=app
GOOGLE_SHEETS_TAB_REKRUTMEN=Rekrutmen
GOOGLE_SHEETS_TAB_AKTIVITAS=Aktivitas
GOOGLE_SHEETS_TAB_SUMBER=Form Responses 1
GOOGLE_SHEETS_TAB_PENGGUNA=USERS

# Cara memakai akun app lama.
#   upgrade = cek tab USERS saat login pertama, lalu simpan lokal (default)
#   sheet   = selalu cek tab USERS
#   off     = hanya akun lokal
LEGACY_AUTH_MODE=upgrade
